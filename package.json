    "test:blackbox:admin": "playwright test tests/blackbox-admin-evidence.spec.ts --project=chromium --reporter=list",
    "test:blackbox:guru": "playwright test tests/blackbox-guru-evidence.spec.ts --project=chromium --reporter=list",
    "test:blackbox:siswa": "playwright test tests/blackbox-siswa-evidence.spec.ts --project=chromium --reporter=list"
  },
