{
  "name": "bimbel-new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:blackbox:evidence": "playwright test tests/blackbox-landing-evidence.spec.ts --project=chromium --reporter=list",
